# Zkopíruj na .env a vyplň. .env je v .gitignore.

# Stripe (Connect Express — destination charges)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transakční mail)
RESEND_API_KEY=

# Web Push (vygeneruj příkazem: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print('PUBLIC=', v.public_key); print('PRIVATE=', v.private_key)")
PUSH_PUBLIC=
PUSH_PRIVATE=

# Cloudflare R2 (volitelně, jinak ukládáme na disk do uploads/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Coming-soon brána. COMING_SOON=1 schová celou aplikaci za úvodní stránku
# s waitlistem; přihlášený uživatel a kdo zná heslo projdou dál.
# COMING_SOON_TOKEN je sdílené heslo z té stránky — ne uživatelský účet.
# Health check, Stripe webhooky, přihlášení a právní stránky projdou vždy.
COMING_SOON=
COMING_SOON_TOKEN=

# Postgres v produkci, jinak SQLite v inklink.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
