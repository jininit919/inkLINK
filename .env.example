# Zkopíruj na .env a vyplň. .env je v .gitignore.

# Stripe (Connect Express — destination charges)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transakční mail)
RESEND_API_KEY=

# Web Push (vygeneruj příkazem: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print('PUBLIC=', v.public_key); print('PRIVATE=', v.private_key)")
PUSH_PUBLIC=
PUSH_PRIVATE=

# Cloudflare R2 (volitelně, jinak ukládáme na disk do uploads/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Šifrování zdravotních poznámek klientů (CRM).
# Vygeneruj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# POZOR: tenhle klíč NIKDY nepřegeneruj a neztrať. Na rozdíl od SECRET_KEY
# (kde přegenerování jen odhlásí uživatele) tady ztráta klíče znamená, že
# všechny uložené zdravotní poznámky jsou nenávratně nečitelné.
# Bez klíče appka normálně jede, jen zdravotní poznámky vrací 503.
MEDICAL_NOTES_KEY=

# Postgres v produkci, jinak SQLite v inklink.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
