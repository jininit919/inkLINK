# Zkopíruj na .env a vyplň. .env je v .gitignore.

# Stripe (Connect Express — destination charges)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transakční mail)
RESEND_API_KEY=

# Web Push (vygeneruj příkazem: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print('PUBLIC=', v.public_key); print('PRIVATE=', v.private_key)")
PUSH_PUBLIC=
PUSH_PRIVATE=

# Cloudflare R2 (volitelně, jinak ukládáme na disk do uploads/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Coming-soon brána. COMING_SOON=1 schová celou aplikaci za úvodní stránku
# s waitlistem. Dovnitř se dostane přihlášený uživatel (/login je vždy
# otevřené) nebo kdokoli s odkazem https://.../?preview=<COMING_SOON_TOKEN>.
# Token je volitelný — bez něj funguje jen cesta přes přihlášení.
# Health check, Stripe webhooky, přihlášení a právní stránky projdou vždy.
COMING_SOON=
COMING_SOON_TOKEN=

# Instagram — import portfolia tatéra.
# Aplikace se zakládá na developers.facebook.com/apps/create/ (typ Business),
# pak Add Product → Instagram → "Instagram API setup with Instagram login".
# Do Redirect URI patří:  https://www.inklink.club/api/instagram/callback
# Tatér musí mít profesionální účet (Business/Creator), osobní API nepustí.
# Než projde App Review u Mety, funguje to jen na účtech přidaných v aplikaci
# jako testeři. Bez těchhle proměnných se propojení v nastavení neukáže.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Postgres v produkci, jinak SQLite v inklink.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
