# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/

# SQLite (local dev DB)
*.db
*.db-journal
*.db-wal
*.db-shm
!inklink.db.example

# Uploads / user content
public/uploads/*
!public/uploads/.gitkeep

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Node / mobile
node_modules/
mobile/node_modules/
mobile/package-lock.json

# Capacitor build artifacts — generated by `npx cap add ios/android`
# These are ~500 MB and must NOT be committed. Xcode/Studio open them
# locally after `cap add`; Capacitor config lives in mobile/capacitor.config.json.
mobile/ios/
mobile/android/
# PWA icons — generated by @capacitor/assets; source is mobile/assets/icon.png
mobile/icons/

# Local Flask session secret (auto-generated in dev)
.session_secret

# Xcode local
*.xcuserdata/
DerivedData/
xcuserdata/

# Android local
.gradle/
local.properties

# Environment / secrets
.env
.env.local
.env.production
*.p8
*.jks
*.keystore

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

# Logs
*.log

# macOS
.AppleDouble
.LSOverride

# Temporary Sentry key file (written by APNs bootstrap)
apns_key_*.p8
